{
  "name": "0xnuller",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "0xNullAI 平台 monorepo：@dg-kit 共享层、Agent/Chat/Voice/Market 四模块、文档站、MCP 服务端与安卓应用",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xNullAI/0xNuller.git"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*/*",
    "apps/*",
    "android/*",
    "workers/*"
  ],
  "scripts": {
    "build:kit": "npm run build -w @dg-kit/core && npm run build -w @dg-kit/protocol -w @dg-kit/waveforms && npm run build -w @dg-kit/safety -w @dg-kit/tools -w @dg-kit/transport-webbluetooth -w @dg-kit/transport-tauri-blec",
    "build": "npm run build:kit && npm run build --workspaces --if-present --include-workspace-root=false",
    "typecheck": "npm run build:kit && npm run typecheck --workspaces --if-present --include-workspace-root=false",
    "test": "npm run build:kit && node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/check-format-changed.mjs",
    "clean": "rm -rf packages/*/*/dist packages/*/*/tsconfig.tsbuildinfo apps/*/dist",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build:kit && changeset publish",
    "android:init": "npm run tauri -w @0xnullai/android -- android init --ci && npm run android:prepare",
    "android:prepare": "node scripts/prepare-android-release.mjs",
    "android:dev": "npm run android:prepare && npm run android:dev -w @0xnullai/android",
    "android:build": "node scripts/run-android-release-build.mjs",
    "verify:android:apk": "node scripts/verify-android-apk.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "verify:data": "node scripts/verify-data-platform.mjs",
    "release:data:preflight": "node scripts/release-data-preflight.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "workerd@1.20260801.1": true,
    "sharp@0.35.2": true,
    "sharp@0.33.5": true,
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true,
    "github:0xNullAI/tauri-plugin-blec-multi#f493c3d7443663a0d867e8d52eea9c80697f0c24": true,
    "@stoprocent/noble@2.7.1": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "usb@2.18.0": true,
    "@serialport/bindings-cpp@12.0.1": true
  }
}
