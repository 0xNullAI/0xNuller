{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xnullai-browser-migration",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "routes": [
    {
      "pattern": "agent.0xnullai.com/.well-known/0xnullai-browser-migration-v1*",
      "zone_name": "0xnullai.com",
    },
    {
      "pattern": "chat.0xnullai.com/.well-known/0xnullai-browser-migration-v1*",
      "zone_name": "0xnullai.com",
    },
    {
      "pattern": "voice.0xnullai.com/.well-known/0xnullai-browser-migration-v1*",
      "zone_name": "0xnullai.com",
    },
    {
      "pattern": "market.0xnullai.com/.well-known/0xnullai-browser-migration-v1*",
      "zone_name": "0xnullai.com",
    },
    {
      "pattern": "wiki.0xnullai.com/.well-known/0xnullai-browser-migration-v1*",
      "zone_name": "0xnullai.com",
    },
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
}
