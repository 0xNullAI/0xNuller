{
  "name": "@0xnullai/auth-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "0xNullAI 账号服务：可选账号，不参与任何设备控制",
  "dependencies": {
    "@0xnullai/ai-pricing": "0.1.0",
    "@0xnullai/auth": "0.1.0",
    "@0xnullai/observability": "0.1.0",
    "@0xnullai/scenes": "0.1.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "types": "wrangler types worker-configuration.d.ts --env-file ../../config/wrangler-types.env --include-runtime false --strict-vars false",
    "types:check": "wrangler types worker-configuration.d.ts --env-file ../../config/wrangler-types.env --include-runtime false --strict-vars false --check",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply 0xnullai-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply 0xnullai-auth --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "wrangler": "^4.130.0"
  }
}
