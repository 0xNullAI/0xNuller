{
  "name": "@0xnullai/auth-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "0xNullAI 账号服务：可选账号，不参与任何设备控制",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply 0xnullai-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply 0xnullai-auth --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1"
  }
}
