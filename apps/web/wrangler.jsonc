{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xnuller",
  // 钉住账号，避免同一登录下多账号时部署到错误账号。
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "compatibility_date": "2026-08-09",

  // 统一 Web 外壳；API 由更具体的 Worker 路由接管。
  "routes": [
    // 根域继续使用现有 DNS；Worker route 接管页面，更具体的 API routes 优先。
    { "pattern": "0xnullai.com/*", "zone_name": "0xnullai.com" },
    { "pattern": "www.0xnullai.com", "custom_domain": true },
  ],
  // 生产静态外壳只通过正式域名提供；预览使用本地或隔离的 staging。
  "workers_dev": false,
  "preview_urls": false,

  // 纯静态资源，不配置 Worker 代码或 binding。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },

  "observability": {
    "enabled": true,
  },
}
