{
  "name": "0xnullai-voice",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "diagnose:glm": "node scripts/glm-connftest.mjs",
    "trial:key": "node scripts/gen-trial-key.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@0xnullai/native": "0.1.0",
    "@0xnullai/permissions": "0.1.0",
    "@0xnullai/scenes": "0.1.0",
    "@0xnullai/settings": "0.1.0",
    "@0xnullai/ui": "0.1.0",
    "@0xnullai/waveforms": "0.1.0",
    "@dg-kit/core": "^1.14.0",
    "@dg-kit/protocol": "^1.14.0",
    "@dg-kit/safety": "1.14.0",
    "@dg-kit/tools": "^1.14.0",
    "@dg-kit/transport-webbluetooth": "^1.14.0",
    "@dg-kit/waveforms": "^1.14.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5",
    "wrangler": "^4.98.0"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
