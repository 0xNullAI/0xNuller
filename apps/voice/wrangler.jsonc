{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 独立脚本保留旧版 dg-voice；首次上线后保持名称稳定，以免重建 TrialSession 数据。
  "name": "0xnullai-voice",
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["XAI_API_KEY", "TRIAL_KEYS"] },

  // 统一域下只认领体验版这一条路径。独立部署形态已不再保留，静态资源由统一外壳
  // （0xnuller）提供，所以这里不再挂 assets——也就不需要 run_worker_first。
  "routes": [{ "pattern": "0xnullai.com/api/realtime", "zone_name": "0xnullai.com" }],
  // 保留 workers.dev 预发地址作为备用/调试入口。
  "workers_dev": true,

  // 体验版计量 Durable Object：每个激活密钥一个实例，管并发 / 单次时长 / 每日总量。
  "durable_objects": {
    "bindings": [{ "name": "TRIAL_SESSION", "class_name": "TrialSession" }],
  },
  // SQLite-backed DO (`new_sqlite_classes`, not `new_classes`): required on the
  // free Workers plan, and the only variant that supports the free tier. Our
  // TrialSession only uses storage.get/put + alarms, all supported here.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrialSession"] }],

  // 非机密配置。机密（真 xAI Key、激活密钥表）用 `wrangler secret put` 设置：
  //   wrangler secret put XAI_API_KEY
  //   wrangler secret put TRIAL_KEYS   # JSON：{"dgv-trial-xxx":{"dailyCapMinutes":30}}
  "vars": {
    "TRIAL_MODEL": "grok-voice-think-fast-1.0",
    "TRIAL_MAX_SESSION_MINUTES": "20",
    "TRIAL_DEFAULT_DAILY_CAP_MINUTES": "60",
    "TRIAL_DISABLED": "0",
    // 统一域。漏掉的话体验版一律 403，而前端只会显示「连接失败」。
    "TRIAL_ALLOWED_ORIGINS": "https://0xnullai.com,https://www.0xnullai.com,http://tauri.localhost",
  },

  "observability": {
    "enabled": true,
  },
}
