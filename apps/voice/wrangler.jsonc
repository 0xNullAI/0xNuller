{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xnullai-voice",
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["XAI_API_KEY"] },
  "services": [
    { "binding": "AUTH", "service": "0xnullai-auth", "entrypoint": "AuthOwnershipService" },
  ],
  "routes": [{ "pattern": "0xnullai.com/api/realtime", "zone_name": "0xnullai.com" }],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "VOICE_SESSION", "class_name": "ManagedVoiceSession" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TrialSession"] },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "TrialSession", "to": "ManagedVoiceSession" }],
    },
  ],
  "vars": {
    "MANAGED_MODEL": "grok-voice-think-fast-2.0",
    "MAX_SESSION_MINUTES": "20",
    "MANAGED_DISABLED": "0",
    "ALLOWED_ORIGINS": "https://0xnullai.com,https://www.0xnullai.com,http://tauri.localhost",
  },
  "observability": { "enabled": true },
}
