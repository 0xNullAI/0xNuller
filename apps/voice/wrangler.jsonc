{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 保持名称稳定，以保留 TrialSession 数据。
  "name": "0xnullai-voice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["XAI_API_KEY"] },

  "services": [
    { "binding": "AUTH", "service": "0xnullai-auth", "entrypoint": "AuthOwnershipService" },
  ],

  // 统一外壳下的实时语音体验 API。
  "routes": [{ "pattern": "0xnullai.com/api/realtime", "zone_name": "0xnullai.com" }],
  "workers_dev": true,

  // 体验版会话状态。
  "durable_objects": {
    "bindings": [{ "name": "TRIAL_SESSION", "class_name": "TrialSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrialSession"] }],

  "vars": {
    "TRIAL_MODEL": "grok-voice-think-fast-1.0",
    "TRIAL_MAX_SESSION_MINUTES": "20",
    "TRIAL_DISABLED": "0",
    "TRIAL_ALLOWED_ORIGINS": "https://0xnullai.com,https://www.0xnullai.com,http://tauri.localhost",
  },

  "observability": {
    "enabled": true,
  },
}
