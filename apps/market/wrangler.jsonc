{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xnullai-market",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],

  // 统一外壳占据根域，本 Worker 只接管市场 API。
  "routes": [
    { "pattern": "0xnullai.com/api/items*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/admin/*", "zone_name": "0xnullai.com" },
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // 库名仍是 dg-market；绑定按 database_id 走。迁移必须统一经 Wrangler
  // migrations 执行，不能再分别维护 schema.sql 与一次性 execute 脚本。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dg-market",
      "database_id": "cf5f0c37-5b39-44f9-ab68-430849f9a4f6",
      "migrations_dir": "migrations",
    },
  ],

  // 机密只用 `wrangler secret put ADMIN_KEY` 设置，勿写进配置或源码。
  "observability": { "enabled": true },
}
