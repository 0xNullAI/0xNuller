{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xnullai-market",
  // 钉住账号，避免同一登录下多账号时部署到错误账号。
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["MARKET_IP_PEPPER"] },

  // Market API。
  "routes": [{ "pattern": "0xnullai.com/api/items*", "zone_name": "0xnullai.com" }],
  // 生产只通过 0xnullai.com 暴露；本地验证使用 wrangler dev。
  "workers_dev": false,
  "preview_urls": false,

  // 数据结构只通过 Wrangler migrations 升级。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dg-market",
      "database_id": "cf5f0c37-5b39-44f9-ab68-430849f9a4f6",
      "migrations_dir": "migrations",
    },
  ],

  // 上传内容绑定当前 Auth 账户。
  "services": [
    {
      "binding": "AUTH",
      "service": "0xnullai-auth",
      "entrypoint": "AuthOwnershipService",
    },
  ],

  "observability": { "enabled": true },
}
