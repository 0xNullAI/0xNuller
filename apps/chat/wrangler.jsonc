{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker 名称与 Durable Object 命名空间已投入使用，禁止更改。
  "name": "0xnullai-chat",
  // 钉住账号，避免同一登录下多账号时部署到错误账号。
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],

  // 与 Auth 使用同一份私聊签名密钥。
  "secrets": { "required": ["DM_TICKET_SECRET", "CHAT_BACKUP_TOKEN"] },

  // 统一外壳下的 Chat API 与 WebSocket 路由。
  "routes": [
    { "pattern": "0xnullai.com/ws/*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/lobby/*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/upload/*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/media/*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/groups/*", "zone_name": "0xnullai.com" },
    { "pattern": "0xnullai.com/api/dm/*", "zone_name": "0xnullai.com" },
  ],
  // 生产只通过 0xnullai.com 暴露；关闭绕过 zone 策略的旁路与版本预览。
  "workers_dev": false,
  "preview_urls": false,

  "services": [{ "binding": "LLM", "service": "dg-llm-proxy" }],

  // 保持类名和 migration tag 稳定，以保留既有房间数据。
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "ACCOUNT_REGISTRY", "class_name": "AccountRegistryDO" },
      { "name": "ROOM_INDEX", "class_name": "RoomIndexDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "LobbyDO"],
    },
    { "tag": "v2-account-registry", "new_sqlite_classes": ["AccountRegistryDO"] },
    { "tag": "v3-room-index", "new_sqlite_classes": ["RoomIndexDO"] },
  ],

  // 图片与语音对象存储。
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dg-chat-media" }],

  "observability": {
    "enabled": true,
  },
}
