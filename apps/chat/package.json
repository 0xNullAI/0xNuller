{
  "name": "0xnullai-chat",
  "private": true,
  "version": "2.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types worker-configuration.d.ts --env-file ../../config/wrangler-types.env --include-runtime false --strict-vars false",
    "types:check": "wrangler types worker-configuration.d.ts --env-file ../../config/wrangler-types.env --include-runtime false --strict-vars false --check"
  },
  "dependencies": {
    "@0xnullai/auth": "0.1.0",
    "@0xnullai/llm-providers": "0.1.0",
    "@0xnullai/market-client": "0.1.0",
    "@0xnullai/native": "0.1.0",
    "@0xnullai/scenes": "0.1.0",
    "@0xnullai/settings": "0.1.0",
    "@0xnullai/sync": "0.1.0",
    "@0xnullai/ui": "0.1.0",
    "@0xnullai/waveforms": "0.1.0",
    "@dg-kit/core": "^1.13.0",
    "@dg-kit/protocol": "^1.13.0",
    "@dg-kit/safety": "1.13.0",
    "@dg-kit/transport-webbluetooth": "^1.13.0",
    "@dg-kit/waveforms": "^1.13.0",
    "fflate": "^0.8.2",
    "lucide-react": "^1.11.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5",
    "wrangler": "^4.98.0"
  }
}
