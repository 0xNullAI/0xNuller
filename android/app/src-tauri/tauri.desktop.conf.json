{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.nullai.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "0xNuller",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "infoPlist": "Info.desktop.plist",
      "entitlements": "Entitlements.desktop.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
