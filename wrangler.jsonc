{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dg-voice",
  "account_id": "9c36f42d1cb5ba53e644de21a014d028",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",

  // 生产自定义域：voice.0xnullai.com。
  "routes": [{ "pattern": "voice.0xnullai.com", "custom_domain": true }],
  // 保留 workers.dev 预发地址作为备用/调试入口。
  "workers_dev": true,

  // 静态托管 + 体验版代理。自带 Key 的 provider（xAI/OpenAI/Azure/智谱）仍浏览器直连、不经过
  // Worker；只有体验版（trial）的 /api/realtime 走 Worker：`run_worker_first` 让该前缀先进
  // Worker 代码，其余路径直接由 ASSETS 提供。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 体验版计量 Durable Object：每个激活密钥一个实例，管并发 / 单次时长 / 每日总量。
  "durable_objects": {
    "bindings": [{ "name": "TRIAL_SESSION", "class_name": "TrialSession" }]
  },
  // SQLite-backed DO (`new_sqlite_classes`, not `new_classes`): required on the
  // free Workers plan, and the only variant that supports the free tier. Our
  // TrialSession only uses storage.get/put + alarms, all supported here.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrialSession"] }],

  // Cloudflare Email Sending — mails the daily rotating key. Onboard the sender
  // domain once: `wrangler email sending enable 0xnullai.com` (adds SPF+DKIM DNS).
  "send_email": [{ "name": "EMAIL" }],

  // 每天 12:00 UTC = 00:00 AOE（UTC-12）：轮换并邮寄当日体验版密钥。
  "triggers": { "crons": ["0 12 * * *"] },

  // 非机密配置。机密用 `wrangler secret put` 设置：
  //   wrangler secret put XAI_API_KEY
  //   wrangler secret put TRIAL_KEYS         # 静态密钥表 JSON（可选，与每日密钥并存）
  //   wrangler secret put TRIAL_DAILY_SEED   # 每日密钥的 HMAC 种子（openssl rand -base64 32）
  //   wrangler secret put TRIAL_KEY_EMAIL_TO # 收件邮箱（个人地址，仓库公开，故走 secret）
  "vars": {
    "TRIAL_MODEL": "grok-voice-think-fast-1.0",
    "TRIAL_MAX_SESSION_MINUTES": "20",
    "TRIAL_DEFAULT_DAILY_CAP_MINUTES": "60",
    "TRIAL_DAILY_CAP_MINUTES": "60",
    "TRIAL_DAILY_GRACE_MINUTES": "180",
    "TRIAL_KEY_EMAIL_FROM": "trial@0xnullai.com",
    "TRIAL_DISABLED": "0",
    "TRIAL_ALLOWED_ORIGINS": "https://voice.0xnullai.com"
  },

  "observability": {
    "enabled": true
  }
}
